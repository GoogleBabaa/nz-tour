{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/services.html",
      "destination": "/services",
      "permanent": false
    },
    {
      "source": "/nz-group.html",
      "destination": "/nz-group",
      "permanent": false
    }
  ]
}
